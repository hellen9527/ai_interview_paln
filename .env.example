# Copy to .env. Never expose these keys through VITE_* variables.
PORT=3001
LLM_PROVIDER=OpenAI-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional OpenAI-compatible speech transcription endpoint. Separate from text LLM.
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional controls
LLM_JSON_MODE=true
UPSTREAM_TIMEOUT_MS=45000
API_RATE_LIMIT_MAX=30
